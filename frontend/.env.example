# Vite environment variables for the Token Vesting frontend
# (specs/001-token-vesting-app/plan.md, research R12).
#
# Copy this file to `frontend/.env.local` and fill in the values.
# `.env*` files are gitignored EXCEPT this template (root `.gitignore`).
# The app builds with NONE of these set — they only tune the live site.

# OPTIONAL — JSON-RPC endpoint for the chain in VITE_CHAIN_ID.
# Leave unset/empty to use viem's default public RPC for that chain.
# Get one from your node provider (Alchemy, Infura, ...) or a public endpoint.
VITE_RPC_URL=

# WalletConnect Cloud project id — create a FREE project at
# https://cloud.reown.com (WalletConnect Cloud).
# REQUIRED for WalletConnect wallets (mobile apps / QR pairing) on the live
# site; injected wallets (MetaMask, Rabby, ...) work without it.
VITE_WALLETCONNECT_PROJECT_ID=

# Target chain id:
#   11155111 = Sepolia (for the public v1 deployment / live site)
#    31337   = local anvil (for development)
VITE_CHAIN_ID=11155111
